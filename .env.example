# Copie este arquivo para ".env" e ajuste os valores.

# Dev (SQLite, zero setup):
DATABASE_URL=sqlite:///./ingles_ia.db

# Produção (Postgres), exemplo — depois de "pip install -r requirements-postgres.txt":
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/ingles_ia

# Gere uma chave forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

APP_NAME=Inglês IA
ENVIRONMENT=development

# Gemini — geração de flashcards e quiz.
# Pode colocar mais de uma chave separada por vírgula (rotação automática
# se uma esgotar a cota): GEMINI_API_KEYS=chave1,chave2,chave3
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite

# CORS — em dev deixe "*" (padrão). Em produção, defina o domínio real do
# frontend (ex: https://ingles-ia.vercel.app), separado por vírgula se
# tiver mais de um (produção + preview, por exemplo).
CORS_ORIGINS=*
