  const [respostas, setRespostas] = useState({}) // { [pergunta_id]: opcao_selecionada }
  const [resultado, setResultado] = useState(null)
  const [enviando, setEnviando] = useState(false)

  useEffect(() => {
    obterQuiz(levelId, lessonId)
